{
  "name": "@daybell/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Daybell design system: tokens, Tailwind theme and React components (D7, D112).",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./tokens.json": "./src/tokens.json",
    "./studio-colors": "./src/lib/studio-colors.ts"
  },
  "scripts": {
    "gen": "node scripts/build-theme.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@daybell/core": "workspace:*",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.13.0",
    "jsdom": "27.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "5.0.2"
  }
}
