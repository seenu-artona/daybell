{
  "name": "@daybell/image-worker",
  "version": "0.0.0",
  "private": true,
  "description": "AWS Lambda in the studio's region that makes each uploaded photo's previews (D60, D100, D113; ADR 0016).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@daybell/core": "workspace:*",
    "@daybell/image-pipeline": "workspace:*",
    "@daybell/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "vitest": "5.0.2"
  }
}
