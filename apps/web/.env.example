# Copy to apps/web/.env.local for local development. Never commit real values.

# Regional databases (D113, D122). A region is offered only when both of its values are set.
NEXT_PUBLIC_SUPABASE_URL_CA=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_CA=
NEXT_PUBLIC_SUPABASE_URL_US=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_US=

# Each region's Supabase secret key (sb_secret_…, or the legacy service_role key). Server-only, never NEXT_PUBLIC_.
# Used only for the database functions that write access codes (ADR 0011). Local: `supabase status` prints it.
SUPABASE_SECRET_KEY_CA=
SUPABASE_SECRET_KEY_US=

# The address emailed links point to.
SITE_URL=http://localhost:3000

# The parent shop's address, printed on QR cards without https:// (ADR 0015). Leave empty to print SITE_URL/shop (or,
# on Vercel, the deployment's own address with /shop; ADR 0022) until the shop's domain exists.
SHOP_URL=

# Parent access codes (ADR 0011). Server-only; two different keys, each made with: openssl rand -base64 32
# Losing the encryption key means codes can't be shown or printed; losing the HMAC key breaks parent lookup.
ACCESS_CODE_HMAC_KEY=
ACCESS_CODE_ENCRYPTION_KEY=

# The parent shop (ADR 0022). Server-only: keys the HMACs wrong access codes and requests are counted by (no address is
# ever stored). 32 random bytes, different from both access code keys: openssl rand -base64 32
SHOP_THROTTLE_KEY=
# "1" counts the shop's requests by x-forwarded-for (development and tests behind a local server only; ignored on
# Vercel). Unset, every request shares one strict bucket (security review R6).
SHOP_TRUST_XFF=1

# Photos (ADR 0016). "local" keeps photos in apps/web/.storage and makes previews in the app (development and tests;
# refused in production). On Vercel: "s3", with the variables below; see docs/aws-staging-photos.md.
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.storage
# S3 in Canada, through Vercel's OIDC role (no AWS keys anywhere). AWS_REGION must be ca-central-1.
PHOTO_BUCKET_CA=
PHOTO_QUEUE_URL_CA=
AWS_ROLE_ARN=
AWS_REGION=
# The image worker signs its calls with one of these (comma-separated during a rotation), each from: openssl rand -base64 32
PHOTO_WORKER_SECRETS=
# Vercel Cron sends this to the cron routes. openssl rand -base64 32
CRON_SECRET=
# Optional: GitHub Actions' own token for the cron routes (staging's hourly jobs cron; docs/crons.md). Different from
# CRON_SECRET. openssl rand -base64 32
GITHUB_CRON_SECRET=

# Payouts with Stripe Connect (ADR 0020; docs/stripe-staging.md). "fake" keeps a pretend Stripe in the app's memory
# (development and tests; refused on Vercel). "stripe" uses the real API with a test-mode key outside production.
# Leave STRIPE_DRIVER empty and payouts say they aren't set up here.
STRIPE_DRIVER=fake
# Server-only, never NEXT_PUBLIC_. The platform's secret (sk_test_…) or restricted (rk_test_…) key; stripe driver only.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_…), or two comma-separated while rolling one. The fake driver signs its
# pretend events with it, so set any whsec_ value of 16+ characters locally, e.g. whsec_ plus: openssl rand -hex 24
STRIPE_WEBHOOK_SECRET=
