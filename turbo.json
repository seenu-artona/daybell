{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/drm-test/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_*",
        "DRM_TEST_PAGE_ENABLED",
        "DRM_TEST_KEY_ID",
        "DRM_TEST_CONTENT_KEY",
        "SITE_URL",
        "SHOP_URL",
        "STORAGE_DRIVER",
        "STRIPE_DRIVER",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_URL",
        "VERCEL_BRANCH_URL",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ]
    },
    "typecheck": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
